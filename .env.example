# Whisker / Litter-Robot account credentials
LITTERROBOT_USERNAME=you@example.com
LITTERROBOT_PASSWORD=your-password

# Twilio credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15551234567
TWILIO_TO_NUMBER=+15557654321

# How often to poll the Litter-Robot API, in minutes
POLL_INTERVAL_MINUTES=15

# Alert thresholds (percent)
WASTE_DRAWER_FULL_THRESHOLD=80
LITTER_LEVEL_LOW_THRESHOLD=20

# Percent the reading must recover past a threshold before an alert can fire
# again for the same condition (prevents repeat texts while it hovers near
# the threshold). E.g. if the drawer threshold is 80 and hysteresis is 10,
# the drawer must drop back below 70 before a new "drawer full" text is sent.
ALERT_HYSTERESIS=10
